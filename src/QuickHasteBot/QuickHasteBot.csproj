<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>QuickHasteBot</RootNamespace>
    <AssemblyName>QuickHasteBot</AssemblyName>
    <ApplicationIcon>Assets\QuickHasteBot.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Product>QuickHasteBot</Product>
    <Description>Textbausteine per Hotkey suchen und einfügen</Description>
    <Authors>opuslux</Authors>
    <Copyright>Copyright © 2026 opuslux</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <!-- Nur falls git fehlt, sonst kommt die Version vom letzten Tag (siehe VersionFromGit unten) -->
    <Version>0.0.0-dev</Version>

    <!-- WPF0001: ThemeMode (Fluent) ist in .NET 10 noch als experimentell markiert -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>

    <!-- dotnet publish -c Release -r win-x64 → eine einzelne exe, braucht die .NET 10 Desktop Runtime -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Editor mit Farben für Tags und Skripte (SnippetHighlighting) -->
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Jint" Version="4.17.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\QuickHasteBot.ico" />
    <!-- MediaElement spielt nur Dateien ab, das Video wird beim Öffnen der Einstellungen nach %TEMP% entpackt -->
    <EmbeddedResource Include="Assets\RoboClip.mp4" LogicalName="RoboClip.mp4" />
    <!-- Beispielordner, wird beim ersten Start in der Sprache der Oberfläche als structure angelegt (SampleStructure) -->
    <EmbeddedResource Include="Samples\**\*" LogicalName="Samples/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Oberflächentexte: Strings.resx Englisch (Standard), Strings.de.resx Deutsch. Die Klasse Strings entsteht beim Build. -->
  <ItemGroup>
    <EmbeddedResource Update="UI\Strings.resx" StronglyTypedLanguage="CSharp" StronglyTypedClassName="Strings"
                      StronglyTypedNamespace="QuickHasteBot.UI" StronglyTypedFileName="$(IntermediateOutputPath)Strings.Designer.cs"
                      PublicClass="true" />
  </ItemGroup>

  <!--
    Der WPF-Zwischenbau für das XAML (…_wpftmp.csproj) erzeugt keine Ressourcen und kennt Strings sonst nicht.
    Darum die Klasse schon vor dem XAML-Schritt erzeugen und dem Zwischenbau als fertige Datei mitgeben.
  -->
  <Target Name="StringsBeforeMarkupCompile" BeforeTargets="MarkupCompilePass1" DependsOnTargets="PrepareResourceNames;CoreResGen"
          Condition="!$(MSBuildProjectName.EndsWith('_wpftmp'))" />
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <Compile Include="$(IntermediateOutputPath)Strings.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QuickHasteBot.Tests" />
    <!-- WPF lässt System.IO aus den ImplicitUsings weg (Konflikt mit Shapes.Path), wir brauchen es überall -->
    <Using Include="System.IO" />
  </ItemGroup>

  <!--
    Version aus dem letzten Tag vX.Y.Z, damit die Anzeige in den Einstellungen auch bei lokalen Builds stimmt:
    genau auf dem Tag "2.1.0", drei Commits danach "2.1.0-dev.3", mit nicht committeten Änderungen zusätzlich ".dirty".
    Ein -p:Version=… von aussen (Release-Workflow) hat immer Vorrang.
  -->
  <Target Name="VersionFromGit" BeforeTargets="GetAssemblyVersion" Condition="'$(Version)' == '0.0.0-dev'">
    <Exec Command="git describe --tags --long --dirty --match v[0-9]*" WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDescribe" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExitCode" />
    </Exec>

    <!-- z.B. v2.1.0-2-gc8e4ae3-dirty -->
    <PropertyGroup Condition="'$(_GitExitCode)' == '0'">
      <_GitPattern>^v(\d+\.\d+\.\d+)-(\d+)-g[0-9a-f]+(-dirty)?$</_GitPattern>
      <_GitTag>$([System.Text.RegularExpressions.Regex]::Replace('$(_GitDescribe)', '$(_GitPattern)', '$1'))</_GitTag>
      <_GitCommits>$([System.Text.RegularExpressions.Regex]::Replace('$(_GitDescribe)', '$(_GitPattern)', '$2'))</_GitCommits>
      <_GitDirty>$([System.Text.RegularExpressions.Regex]::Replace('$(_GitDescribe)', '$(_GitPattern)', '$3'))</_GitDirty>
    </PropertyGroup>

    <PropertyGroup Condition="'$(_GitExitCode)' == '0' And '$(_GitTag)' != '$(_GitDescribe)'">
      <Version>$(_GitTag)</Version>
      <Version Condition="'$(_GitCommits)' != '0'">$(Version)-dev.$(_GitCommits)</Version>
      <Version Condition="'$(_GitDirty)' != '' And '$(_GitCommits)' != '0'">$(Version).dirty</Version>
      <Version Condition="'$(_GitDirty)' != '' And '$(_GitCommits)' == '0'">$(Version)-dirty</Version>
    </PropertyGroup>
  </Target>

</Project>
