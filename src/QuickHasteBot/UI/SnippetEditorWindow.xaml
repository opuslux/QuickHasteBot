<Window x:Class="QuickHasteBot.UI.SnippetEditorWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:QuickHasteBot.UI"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        Icon="pack://application:,,,/QuickHasteBot;component/Assets/QuickHasteBot.ico"
        Width="820" Height="600" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing">

    <Window.Resources>
        <!-- Umschalter als Symbol wie in der Textvorschau des Popups, eingeschaltet in Akzentfarbe -->
        <Style x:Key="IconToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16,12,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Name der Datei, Endung fest dahinter. Umbenannt wird beim Speichern. -->
        <DockPanel Grid.Row="0">
            <TextBlock Text="{x:Static ui:Strings.EditorName}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <!-- Ganz rechts und mit Abstand der Ordner, die Endung direkt am Namen: sonst liest es sich wie "Name Ordner.txt" -->
            <!-- Ein Klick wählt einen anderen Ordner, verschoben bzw. angelegt wird beim Speichern -->
            <Button x:Name="FolderButton" DockPanel.Dock="Right" VerticalAlignment="Center" MaxWidth="320" Margin="14,0,0,0" Padding="6,3"
                    Cursor="Hand" Click="OnFolderClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                               VerticalAlignment="Center" Margin="6,1,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <!-- Dasselbe Ordnersymbol wie in der Liste, etwas kleiner als der Text -->
                    <TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                               VerticalAlignment="Center" Margin="0,1,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="FolderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </DockPanel>
            </Button>
            <TextBlock x:Name="ExtensionText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="4,0,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBox x:Name="NameInput" TextChanged="OnNameChanged" />
        </DockPanel>

        <!-- Werkzeuge: Tags einfügen, Element mit dem Fadenkreuz erfassen, Skriptblock bzw. ganzes Skript mit KI, Formular
             aufnehmen. Ganz rechts die Hilfe. Ist der Editor zu schmal, brechen die Knöpfe in eine zweite Zeile um,
             statt abgeschnitten zu werden. Abstand rechts und unten an jedem Knopf, damit auch die zweite Zeile passt. -->
        <Grid x:Name="Toolbar" Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="HelpButton" Grid.Column="1" VerticalAlignment="Top" Margin="0,0,0,6" ToolTip="{x:Static ui:Strings.HelpToolTip}" Click="OnHelpClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE897;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Static ui:Strings.Help}" Margin="6,0,0,0" />
                </StackPanel>
            </Button>
            <WrapPanel x:Name="ToolbarButtons">
                <Button x:Name="TagsButton" Margin="0,0,8,6" Content="{x:Static ui:Strings.EditorInsertTag}" ToolTip="{x:Static ui:Strings.EditorInsertTagToolTip}"
                        Click="OnTagsClick" />
                <Button Margin="0,0,8,6" ToolTip="{x:Static ui:Strings.EditorPickerToolTip}" Click="OnPickerClick">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.4" VerticalAlignment="Center"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M16,0 L16,11 M16,21 L16,32 M0,16 L11,16 M21,16 L32,16 M6,16 A10,10 0 1 1 26,16 A10,10 0 1 1 6,16" />
                        <TextBlock Text="{x:Static ui:Strings.EditorPicker}" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,8,6" ToolTip="{x:Static ui:Strings.AiPromptTooltip}" Click="OnAiClick">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M7,4 Q7,10 13,10 Q7,10 7,16 Q7,10 1,10 Q7,10 7,4 Z
                                    M13,0 Q13,3 16,3 Q13,3 13,6 Q13,3 10,3 Q13,3 13,0 Z
                                    M3,1 Q3,3 5,3 Q3,3 3,5 Q3,3 1,3 Q3,3 3,1 Z" />
                        <TextBlock Text="{x:Static ui:Strings.EditorAi}" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <!-- HasteScript AI: das ganze Skript mit Doku als Prompt in die Zwischenablage, für eine beliebige KI -->
                <Button x:Name="HasteScriptAiButton" Margin="0,0,8,6" ToolTip="{x:Static ui:Strings.HasteScriptAiToolTip}" Click="OnHasteScriptAiClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static ui:Strings.EditorHasteScriptAi}" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <!-- Aufnehmen: ein Formular einmal selbst ausfüllen, daraus werden Tags -->
                <Button x:Name="RecordButton" Margin="0,0,8,6" ToolTip="{x:Static ui:Strings.EditorRecordToolTip}" Click="OnRecord">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{DynamicResource SystemFillColorCriticalBrush}" />
                        <TextBlock x:Name="RecordButtonText" Text="{x:Static ui:Strings.EditorRecord}" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>

        <!-- AvalonEdit statt TextBox, wegen der Farben (SnippetHighlighting). Rahmen und Hintergrund wie die Fluent-Textfelder. -->
        <Border Grid.Row="2" CornerRadius="4" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter Property="Background" Value="{DynamicResource ControlFillColorInputActiveBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Suchen/Ersetzen (Strg+F/Strg+H) als Streifen oben im Rahmen: der Text rückt darunter, nichts wird verdeckt -->
                <ui:EditorFindBar x:Name="FindBar" />
                <!-- Umbruch setzt ApplyWrap nach der Einstellung, Shift+Mausrad scrollt waagrecht -->
                <ae:TextEditor x:Name="BodyInput" Grid.Row="1" Padding="8,6" Background="Transparent"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalScrollBarVisibility="Auto"
                               FontFamily="Cascadia Mono, Consolas" FontSize="13" TextChanged="OnBodyChanged"
                               ui:ShiftWheel.Horizontal="True" />
                <!-- Zeilennummern und Umbruch an/aus wie in der Textvorschau des Popups: unten rechts, frei von beiden Scrollbalken -->
                <Border x:Name="WrapBox" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16" CornerRadius="4"
                        Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}}">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="LineNumbersToggle" Style="{StaticResource IconToggle}" Width="28" Content="123"
                                      FontFamily="Segoe UI" FontSize="10" ToolTip="{x:Static ui:Strings.LineNumbersTooltip}"
                                      Click="OnLineNumbersClick" />
                        <ToggleButton x:Name="WrapToggle" Style="{StaticResource IconToggle}" Content="&#xE751;"
                                      ToolTip="{x:Static ui:Strings.WrapTooltip}" Click="OnWrapClick" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Was das Skript an der Schreibmarke bzw. die Auswahl ergibt. Nur da, wenn darin ein {{ … }} steht. -->
        <Border x:Name="PreviewBox" Grid.Row="3" Margin="0,8,0,0" Padding="10,6" CornerRadius="4" Visibility="Collapsed"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <DockPanel>
                <TextBlock x:Name="PreviewIcon" DockPanel.Dock="Left" Text="&#xE943;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="12" Margin="0,2,8,0" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="PreviewLabel" DockPanel.Dock="Left" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Top"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="PreviewNote" DockPanel.Dock="Bottom" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />
                <!-- Höchstens drei Zeilen, längere Ergebnisse scrollen -->
                <ScrollViewer MaxHeight="54" Margin="0,2,0,0" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="PreviewText" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Speichern zuerst, dann die Läufe. Schliessen über das Fenster oder Esc. -->
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="SaveButton" Content="{x:Static ui:Strings.EditorSave}" MinWidth="100"
                        Style="{DynamicResource AccentButtonStyle}" ToolTip="Ctrl+S" Click="OnSave" />
                <Button x:Name="StepButton" Content="{x:Static ui:Strings.EditorStepRun}" MinWidth="100" Margin="8,0,0,0"
                        ToolTip="{x:Static ui:Strings.EditorStepRunToolTip}" Click="OnStepRun" />
                <Button x:Name="TestButton" Content="{x:Static ui:Strings.EditorTest}" MinWidth="100" Margin="8,0,0,0"
                        ToolTip="{x:Static ui:Strings.EditorTestToolTip}" Click="OnTest" />
            </StackPanel>
            <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                <!-- Meldung mit Symbol auf leicht getönter Fläche: grün gelungen, rot Fehler, Akzent während eines Laufs -->
                <Border x:Name="StatusBox" Visibility="Collapsed" HorizontalAlignment="Left" CornerRadius="4" Padding="8,5"
                        BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <DockPanel>
                        <TextBlock x:Name="StatusIcon" DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                   Margin="0,0,8,0" VerticalAlignment="Top" />
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </DockPanel>
                </Border>
                <!-- Während des Wartens auf den Klick ins Zielfeld: nicht zu übersehen, in der Akzentfarbe -->
                <Border x:Name="TestBanner" Visibility="Collapsed" CornerRadius="4" Padding="10,6"
                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <TextBlock x:Name="TestBannerText" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
