<Window x:Class="QuickHasteBot.UI.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:QuickHasteBot.UI"
        Title="QuickHasteBot – Einstellungen"
        Icon="pack://application:,,,/QuickHasteBot;component/Assets/QuickHasteBot.ico"
        Width="520" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">

    <StackPanel Margin="24,20,24,20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Image Source="pack://application:,,,/QuickHasteBot;component/Assets/QuickHasteBot.ico" Width="32" Height="32" Margin="0,0,12,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="QuickHasteBot" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Hinweis, solange die alte Version noch mit Windows startet -->
        <Border x:Name="LegacyHint" Visibility="Collapsed" Margin="0,0,0,16" Padding="12" CornerRadius="6"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Eintrag entfernen" Click="OnRemoveLegacyAutostart" VerticalAlignment="Center" />
                <TextBlock Text="Die alte Version QuickPasteBot startet noch mit Windows und belegt evtl. denselben Hotkey."
                           TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TextBlock Text="Hotkey" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ui:HotkeyBox x:Name="HotkeyInput" GestureCaptured="OnHotkeyCaptured" />
        <TextBlock x:Name="HotkeyStatus" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" />

        <TextBlock Text="Einfügen mit Enter" FontWeight="SemiBold" Margin="0,16,0,6" />
        <RadioButton x:Name="PasteClipboard" GroupName="Paste" Checked="OnPasteModeChanged"
                     Content="Über die Zwischenablage (schnell, Zwischenablage bleibt erhalten)" />
        <RadioButton x:Name="PasteTyping" GroupName="Paste" Checked="OnPasteModeChanged"
                     Content="Tippen (auch dort, wo Einfügen gesperrt ist)" />
        <TextBlock Text="Shift+Enter nimmt jeweils die andere Methode." FontSize="12" Margin="0,2,0,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <TextBlock Text="Textbausteine" FontWeight="SemiBold" Margin="0,16,0,6" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Öffnen" Click="OnOpenStructure" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Ändern…" Click="OnBrowseStructure" Margin="6,0,0,0" />
            <TextBox x:Name="StructureInput" LostKeyboardFocus="OnStructureInputCommitted" KeyDown="OnStructureInputKeyDown"
                     ToolTip="Relativ zur exe oder absolut, Umgebungsvariablen wie %USERPROFILE% gehen auch" />
        </DockPanel>
        <TextBlock x:Name="StructureResolved" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <CheckBox x:Name="SearchContentInput" Content="Auch im Inhalt der Textbausteine suchen" Margin="0,8,0,0"
                  Click="OnSearchContentChanged" />

        <TextBlock Text="Allgemein" FontWeight="SemiBold" Margin="0,16,0,6" />
        <CheckBox x:Name="AutostartInput" Content="Mit Windows starten" Click="OnAutostartChanged" />
        <CheckBox x:Name="TrayInput" Content="Tray-Icon anzeigen" Click="OnTrayChanged" Margin="0,4,0,0" />

        <DockPanel Margin="0,24,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="QuickHasteBot beenden" Click="OnExit" />
            <Button DockPanel.Dock="Right" Content="Schliessen" Click="OnClose" IsDefault="True" IsCancel="True" />
        </DockPanel>
    </StackPanel>
</Window>
