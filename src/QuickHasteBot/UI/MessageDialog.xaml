<Window x:Class="QuickHasteBot.UI.MessageDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickHasteBot"
        Icon="pack://application:,,,/QuickHasteBot;component/Assets/QuickHasteBot.ico"
        SizeToContent="WidthAndHeight" MinWidth="360" MaxWidth="560"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="24,20,24,24">
            <!-- Symbol wie bei Windows: Info, Frage, Warnung oder Fehler, in der Farbe des Themes -->
            <TextBlock x:Name="Symbol" DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28"
                       VerticalAlignment="Top" Margin="0,0,16,0" Visibility="Collapsed" />
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Knöpfe unten auf einer abgesetzten Fläche, wie bei Dialogen in Windows 11 -->
        <Border Grid.Row="1" Padding="24,16" BorderThickness="0,1,0,0"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" />
        </Border>
    </Grid>
</Window>
