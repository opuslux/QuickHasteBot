<UserControl x:Class="QuickHasteBot.UI.PopupPositionPicker"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:QuickHasteBot.UI"
             xmlns:core="clr-namespace:QuickHasteBot.Core"
             Focusable="True" HorizontalAlignment="Left">

    <UserControl.Resources>
        <!-- Ein Feld des Rasters mit seiner Ziffer. Die Tastatur bleibt beim ganzen Raster, siehe OnKeyDown. -->
        <Style x:Key="Cell" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="PopupPosition" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Back" Margin="2" CornerRadius="4" Background="Transparent">
                            <ContentPresenter x:Name="Digit" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontSize="11"
                                              TextElement.Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Digit" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Trigger>
                            <!-- Dort zeigt der Mauszeiger hin, die Ziffer würde ihn nur stören -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Back" Property="Opacity" Value="0.25" />
                                <Setter TargetName="Digit" Property="Visibility" Value="Hidden" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Rechts und unten Platz für den Mauszeiger, er ragt an den Rändern über das Mini-Popup hinaus -->
    <Grid Margin="0,0,14,20">
        <!-- Das Popup im Kleinen, Querformat wie das echte -->
        <Border x:Name="Frame" Width="168" Height="104" CornerRadius="6" BorderThickness="1"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}">
            <!-- Angeordnet wie der Ziffernblock -->
            <UniformGrid Rows="3" Columns="3" Margin="1">
                <RadioButton Style="{StaticResource Cell}" Content="7" Tag="{x:Static core:PopupPosition.TopLeft}" ToolTip="{x:Static ui:Strings.PositionTopLeft}" Checked="OnCellChecked" />
                <RadioButton Style="{StaticResource Cell}" Content="8" Tag="{x:Static core:PopupPosition.Top}" ToolTip="{x:Static ui:Strings.PositionTop}" Checked="OnCellChecked" />
                <RadioButton Style="{StaticResource Cell}" Content="9" Tag="{x:Static core:PopupPosition.TopRight}" ToolTip="{x:Static ui:Strings.PositionTopRight}" Checked="OnCellChecked" />
                <RadioButton Style="{StaticResource Cell}" Content="4" Tag="{x:Static core:PopupPosition.Left}" ToolTip="{x:Static ui:Strings.PositionLeft}" Checked="OnCellChecked" />
                <RadioButton Style="{StaticResource Cell}" Content="5" Tag="{x:Static core:PopupPosition.Center}" ToolTip="{x:Static ui:Strings.PositionCenter}" Checked="OnCellChecked" />
                <RadioButton Style="{StaticResource Cell}" Content="6" Tag="{x:Static core:PopupPosition.Right}" ToolTip="{x:Static ui:Strings.PositionRight}" Checked="OnCellChecked" />
                <RadioButton Style="{StaticResource Cell}" Content="1" Tag="{x:Static core:PopupPosition.BottomLeft}" ToolTip="{x:Static ui:Strings.PositionBottomLeft}" Checked="OnCellChecked" />
                <RadioButton Style="{StaticResource Cell}" Content="2" Tag="{x:Static core:PopupPosition.Bottom}" ToolTip="{x:Static ui:Strings.PositionBottom}" Checked="OnCellChecked" />
                <RadioButton Style="{StaticResource Cell}" Content="3" Tag="{x:Static core:PopupPosition.BottomRight}" ToolTip="{x:Static ui:Strings.PositionBottomRight}" Checked="OnCellChecked" />
            </UniformGrid>
        </Border>

        <!-- Der Mauszeiger, die Spitze genau an der gewählten Stelle: Ecke, Kantenmitte oder Mitte -->
        <Canvas HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <Path x:Name="Pointer" Data="M0,0 L0,15 L3.5,11.5 L6,17.5 L8.5,16.5 L6,10.5 L11,10.5 Z"
                  Fill="{DynamicResource AccentFillColorDefaultBrush}"
                  Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="1" StrokeLineJoin="Round">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.4" />
                </Path.Effect>
            </Path>
        </Canvas>
    </Grid>
</UserControl>
