<Window x:Class="QuickHasteBot.UI.AskDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:QuickHasteBot.UI"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True" WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20,16,20,20">
        <!-- Fragezeichen wie bei den Meldungen von confirm(), immer da: Hier wird etwas gefragt -->
        <DockPanel>
            <TextBlock x:Name="Symbol" DockPanel.Dock="Left" Text="&#xE9CE;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="28" VerticalAlignment="Top" Margin="0,0,16,0"
                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <StackPanel>
                <TextBlock x:Name="Prompt" TextWrapping="Wrap" Margin="0,0,0,4" />
                <!-- Pro ask() eine Beschriftung und ein Feld, im Code gefüllt -->
                <ItemsControl x:Name="Fields" Focusable="False" />
            </StackPanel>
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ConfirmButton" Content="{x:Static ui:Strings.AskConfirm}" MinWidth="100" IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}" Click="OnConfirm" />
            <Button Content="{x:Static ui:Strings.Cancel}" MinWidth="100" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
