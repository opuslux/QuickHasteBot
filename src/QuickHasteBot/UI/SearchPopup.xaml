<Window x:Class="QuickHasteBot.UI.SearchPopup"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:QuickHasteBot.UI"
        Title="QuickHasteBot"
        Width="560" Height="460"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Suchfeld mit Platzhalter -->
        <Grid Grid.Row="0">
            <TextBox x:Name="SearchBox"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="16" Padding="10,7" />
            <TextBlock Text="Textbaustein suchen…"
                       FontSize="16" Margin="13,0,0,0" VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding Header}" Margin="4,10,4,4"
                   FontSize="12" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <Grid Grid.Row="2">
            <ListBox x:Name="Results"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding Selected}"
                     Focusable="False"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     SelectionChanged="OnSelectionChanged"
                     MouseDoubleClick="OnResultsDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Padding" Value="8,5" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type ui:SnippetItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding Icon}" Width="20" Height="20"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock TextTrimming="CharacterEllipsis" FontSize="14">
                                    <Run Text="{Binding NameBefore, Mode=OneWay}" /><Run Text="{Binding NameMatch, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /><Run Text="{Binding NameAfter, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Location}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding ShowLocation, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="›" FontSize="16" Margin="8,0,2,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="{Binding EmptyText}" Margin="12" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- Vorschau des gewählten Eintrags -->
        <Border Grid.Row="3" Margin="0,8,0,0" Padding="10,8" CornerRadius="6" MaxHeight="130"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Preview}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding Hints}" Margin="4,8,4,0" FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
    </Grid>
</Window>
