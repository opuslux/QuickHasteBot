<Window x:Class="QuickHasteBot.UI.SearchPopup"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:QuickHasteBot.UI"
        Title="QuickHasteBot"
        Width="720" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1"
        Deactivated="OnDeactivated"
        PreviewMouseLeftButtonDown="OnWindowMouseDown"
        PreviewMouseMove="OnWindowMouseMove"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <!-- Die Einträge sind nicht fokussierbar, die Tastatur bleibt im Suchfeld -->
        <Style x:Key="SnippetContainer" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="6,3" />
            <!-- Volle Breite, damit Ordnerpfeil und Nummer rechtsbündig stehen -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- Kleine Knöpfe mit Symbol, grau, beim Darüberfahren heller -->
        <Style x:Key="IconButton" TargetType="ButtonBase">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Umschalter dazu, eingeschaltet in Akzentfarbe -->
        <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Linker und rechter Fensterrand zum Ändern der Breite, unsichtbar bis auf den Mauszeiger -->
        <Style x:Key="ResizeEdge" TargetType="Thumb">
            <Setter Property="Width" Value="6" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Eine Zeile, links in der Liste und rechts im Inhalt eines Ordners -->
        <DataTemplate x:Key="SnippetTemplate" DataType="{x:Type ui:SnippetItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Source="{Binding Icon}" Width="16" Height="16"
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock TextTrimming="CharacterEllipsis" FontSize="12.5">
                        <Run Text="{Binding NameBefore, Mode=OneWay}" /><Run Text="{Binding NameMatch, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /><Run Text="{Binding NameAfter, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Location}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding ShowLocation, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Hotkey aus dem Dateinamen, dezent. Wirkt er nicht (doppelt, belegt), mit Warnzeichen und Grund im Tooltip. -->
                <Border Grid.Column="2" Margin="6,0,0,0" Padding="5,0,5,1" CornerRadius="3" VerticalAlignment="Center"
                        BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        ToolTip="{Binding HotkeyTooltip}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HotkeyText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Margin="0,1,4,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Visibility="{Binding HasHotkeyProblem, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding HotkeyText}" FontSize="10.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Bei Dateien unsichtbar, aber mit seiner Breite: so stehen die Hotkey-Badges von Ordnern und Dateien bündig -->
                <TextBlock Grid.Column="3" Text="›" FontSize="14" Margin="6,0,2,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Nummer für Alt+1 bis Alt+9, rechtsbündig. Links hat jede Zeile die Spalte, rechts keine. -->
                <TextBlock Grid.Column="4" Text="{Binding Shortcut}" Width="12" Margin="4,0,2,0" TextAlignment="Right"
                           FontSize="11" VerticalAlignment="Center" ToolTip="{Binding ShortcutTooltip}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Shortcut}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid x:Name="Body" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Suchfeld mit Platzhalter, links das App-Icon -->
            <DockPanel Grid.Row="0">
                <Image DockPanel.Dock="Left" Source="pack://application:,,,/QuickHasteBot;component/Assets/QuickHasteBot.ico"
                       Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Grid>
                    <TextBox x:Name="SearchBox"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="16" Padding="10,7" />
                    <TextBlock Text="{x:Static ui:Strings.SearchPlaceholder}"
                               FontSize="16" Margin="13,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DockPanel>

            <!-- Ordnerpfad, übergeordnete Ordner sind anklickbar. Rechts die Stecknadel: nächstes Mal wieder hier beginnen. -->
            <DockPanel Grid.Row="1" Margin="4,6,0,2">
                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource IconToggle}" Content="&#xE718;"
                              IsChecked="{Binding RememberFolder}" ToolTip="{x:Static ui:Strings.RememberFolderTooltip}" />
                <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type ui:Breadcrumb}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="›" FontSize="12" Margin="5,0"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding ShowSeparator, Converter={StaticResource BoolToVisibility}}" />
                                <!-- Symbol und Name zusammen anklickbar, beim Darüberfahren beide in Akzentfarbe -->
                                <StackPanel Orientation="Horizontal" Background="Transparent" MouseLeftButtonUp="OnBreadcrumbClick">
                                    <StackPanel.Resources>
                                        <Style x:Key="CrumbPart" TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNavigable}" Value="True">
                                                    <Setter Property="Cursor" Value="Hand" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsNavigable}" Value="True" />
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Resources>
                                    <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,1,5,0"
                                               Style="{StaticResource CrumbPart}"
                                               Visibility="{Binding IsRoot, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Name}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CrumbPart}">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsNavigable}" Value="True" />
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="TextDecorations" Value="Underline" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- Links die Liste, rechts der Inhalt des markierten Eintrags. Die Höhe gibt die linke Liste vor. -->
            <Grid Grid.Row="2" MinHeight="240">
                <!-- Die Aufteilung kommt aus den Einstellungen, siehe ApplyColumnShare -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ListColumn" Width="*" MinWidth="100" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="DetailColumn" Width="2*" MinWidth="100" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="Results"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding Selected}"
                         Focusable="False"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         ItemContainerStyle="{StaticResource SnippetContainer}"
                         ItemTemplate="{StaticResource SnippetTemplate}"
                         SelectionChanged="OnSelectionChanged"
                         PreviewMouseLeftButtonDown="OnResultsMouseDown"
                         PreviewMouseLeftButtonUp="OnResultsMouseUp"
                         PreviewMouseMove="OnResultsMouseMove"
                         MouseLeave="OnResultsMouseLeave"
                         MouseDoubleClick="OnResultsDoubleClick"
                         PreviewMouseRightButtonUp="OnListRightButtonUp" />

                <TextBlock Text="{Binding EmptyText}" Margin="12" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                <!-- Trenner zum Verschieben: sichtbar ist nur die Linie, greifen lässt er sich auf der ganzen Breite -->
                <GridSplitter Grid.Column="1" Width="17" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Focusable="False"
                              Background="Transparent" DragCompleted="OnSplitterDragCompleted">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="{TemplateBinding Background}">
                                <!-- Rahmenfarbe von Checkboxen: im hellen wie im dunklen Theme gut sichtbar -->
                                <Border x:Name="Line" Width="1" HorizontalAlignment="Center"
                                        Background="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Line" Property="Width" Value="2" />
                                    <Setter TargetName="Line" Property="Background" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="Line" Property="Width" Value="2" />
                                    <Setter TargetName="Line" Property="Background" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <ui:FillDecorator x:Name="DetailHost" Grid.Column="2">
                    <Grid>
                        <ListBox x:Name="DetailList"
                                 ItemsSource="{Binding DetailItems}"
                                 Focusable="False"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 ItemContainerStyle="{StaticResource SnippetContainer}"
                                 ItemTemplate="{StaticResource SnippetTemplate}"
                                 Visibility="{Binding ShowDetailItems, Converter={StaticResource BoolToVisibility}}"
                                 PreviewMouseLeftButtonDown="OnDetailMouseDown"
                                 PreviewMouseLeftButtonUp="OnDetailMouseUp"
                                 MouseDoubleClick="OnDetailDoubleClick"
                                 PreviewMouseRightButtonUp="OnListRightButtonUp" />

                        <!-- Text, Adresse oder Hinweis. Lange Zeilen eines Textes nur auf Wunsch umbrochen, sonst wird horizontal gescrollt. -->
                        <ScrollViewer x:Name="DetailScroll" Focusable="False" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding DetailIsText}" Value="True" />
                                                <Condition Binding="{Binding WrapPreview}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding ShowDetailItems}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <TextBlock Text="{Binding DetailText}" Margin="6,4"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DetailIsText}" Value="True">
                                                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding DetailIsText}" Value="True" />
                                                    <Condition Binding="{Binding WrapPreview}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="TextWrapping" Value="NoWrap" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ScrollViewer>

                        <!-- Umbruch an/aus, nur bei Texten. Unten rechts, frei von beiden Scrollbalken; was darunter liegt, deckt der Fensterhintergrund ab. -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,14" CornerRadius="4"
                                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                Visibility="{Binding DetailIsText, Converter={StaticResource BoolToVisibility}}">
                            <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE751;"
                                          IsChecked="{Binding WrapPreview}" ToolTip="{x:Static ui:Strings.WrapTooltip}" />
                        </Border>
                    </Grid>
                </ui:FillDecorator>
            </Grid>

            <!-- Tastenkürzel, Tasten als Kästchen. Bearbeiten, Explorer und Einstellungen lassen sich auch anklicken. -->
            <StackPanel x:Name="HintBar" Grid.Row="3" Orientation="Horizontal" Margin="4,8,4,0">
                <StackPanel.Resources>
                    <Style TargetType="ui:KeyHint">
                        <Setter Property="Margin" Value="12,0,0,0" />
                    </Style>
                </StackPanel.Resources>
                <ui:KeyHint x:Name="EnterHint" Keys="Enter" Label="{Binding EnterHint}" Margin="0" />
                <ui:KeyHint x:Name="ShiftEnterHint" Keys="Shift Enter" Label="{Binding ShiftEnterHint}" />
                <ui:KeyHint Keys="Ctrl O" Label="{x:Static ui:Strings.HintEdit}" IsLink="True" MouseLeftButtonUp="OnEditClick" />
                <ui:KeyHint Keys="Ctrl E" Label="{x:Static ui:Strings.HintExplorer}" IsLink="True" MouseLeftButtonUp="OnExplorerClick" />
                <ui:KeyHint Keys="Ctrl ," Label="{x:Static ui:Strings.HintSettings}" IsLink="True" MouseLeftButtonUp="OnSettingsClick" />
            </StackPanel>
        </Grid>

        <Thumb x:Name="LeftEdge" Style="{StaticResource ResizeEdge}" HorizontalAlignment="Left"
               DragStarted="OnResizeStarted" DragDelta="OnResizeDelta" DragCompleted="OnResizeCompleted" />
        <Thumb x:Name="RightEdge" Style="{StaticResource ResizeEdge}" HorizontalAlignment="Right"
               DragStarted="OnResizeStarted" DragDelta="OnResizeDelta" DragCompleted="OnResizeCompleted" />
    </Grid>
</Window>
