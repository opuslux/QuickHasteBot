<Window x:Class="QuickHasteBot.UI.HotkeyDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:QuickHasteBot.UI"
        Title="{x:Static ui:Strings.FileHotkeyTitle}"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20,16,20,20">
        <TextBlock x:Name="Prompt" TextWrapping="Wrap" Margin="0,0,0,8" />
        <ui:HotkeyBox x:Name="HotkeyInput" GestureCaptured="OnGestureCaptured" />
        <!-- Konflikt oder Hinweis. Die Höhe bleibt, damit die Knöpfe nicht springen. -->
        <TextBlock x:Name="Problem" FontSize="12" Margin="0,4,0,0" MinHeight="16" TextWrapping="Wrap" />
        <TextBlock x:Name="FileNameText" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <DockPanel Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="RemoveButton" DockPanel.Dock="Left" Content="{x:Static ui:Strings.FileHotkeyRemove}" Click="OnRemove" />
            <Button DockPanel.Dock="Right" Content="{x:Static ui:Strings.Cancel}" MinWidth="100" Margin="8,0,0,0" IsCancel="True" />
            <Button x:Name="ConfirmButton" DockPanel.Dock="Right" Content="{x:Static ui:Strings.FileHotkeyConfirm}" MinWidth="100"
                    IsDefault="True" IsEnabled="False" Style="{DynamicResource AccentButtonStyle}" Click="OnConfirm" />
        </DockPanel>
    </StackPanel>
</Window>
