<Window x:Class="QuickHasteBot.UI.NameDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:QuickHasteBot.UI"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20,16,20,20">
        <TextBlock x:Name="Prompt" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="NameInput" TextChanged="OnNameChanged" />
        <!-- Leer, solange der Name passt. Die Höhe bleibt, damit die Knöpfe beim Tippen nicht springen. -->
        <TextBlock x:Name="Problem" FontSize="12" Margin="0,4,0,0" MinHeight="16" TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ConfirmButton" MinWidth="100" IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}" Click="OnConfirm" />
            <Button Content="{x:Static ui:Strings.Cancel}" MinWidth="100" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
