<Window x:Class="QuickHasteBot.UI.ElementPickerWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:QuickHasteBot.UI"
        Title="{x:Static ui:Strings.PickerTitle}"
        Icon="pack://application:,,,/QuickHasteBot;component/Assets/QuickHasteBot.ico"
        Width="540" SizeToContent="Height"
        ResizeMode="CanMinimize" Topmost="True"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,2,12,2" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,16,20,20">
        <!-- Fadenkreuz: Maustaste drücken, über das Zielelement ziehen, loslassen (wie Spy++ oder Window Spy) -->
        <DockPanel>
            <Border x:Name="Target" DockPanel.Dock="Left" Width="60" Height="60" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}" Cursor="Cross"
                    ToolTip="{x:Static ui:Strings.PickerTargetToolTip}"
                    MouseLeftButtonDown="OnTargetDown" MouseMove="OnTargetMove" MouseLeftButtonUp="OnTargetUp"
                    LostMouseCapture="OnTargetLostCapture">
                <Path x:Name="Crosshair" Width="34" Height="34" Stretch="Uniform" StrokeThickness="1.6"
                      Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                      Data="M16,0 L16,11 M16,21 L16,32 M0,16 L11,16 M21,16 L32,16 M6,16 A10,10 0 1 1 26,16 A10,10 0 1 1 6,16" />
            </Border>
            <TextBlock Text="{x:Static ui:Strings.PickerHint}" TextWrapping="Wrap" Margin="16,0,0,0" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Was unter dem Fadenkreuz liegt, live -->
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="{x:Static ui:Strings.PickerProgram}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Value}" x:Name="ProgramText" Text="–" />
            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{x:Static ui:Strings.PickerType}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" x:Name="TypeText" Text="–" />
            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Id" />
            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" x:Name="IdText" Text="–" />
            <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="{x:Static ui:Strings.PickerName}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" x:Name="NameText" Text="–" />
            <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="{x:Static ui:Strings.PickerClass}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" x:Name="ClassText" Text="–" />
            <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="{x:Static ui:Strings.PickerHelp}" />
            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Value}" x:Name="TooltipText" Text="–" />
            <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="{x:Static ui:Strings.PickerValue}" />
            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Value}" x:Name="ValueText" Text="–" />
        </Grid>

        <!-- Nach dem Loslassen: Aktion, geprüfte Selektoren (der stabilste zuerst) und der fertige Tag -->
        <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
            <Separator Margin="0,14,0,12" />
            <!-- Die Klicks nebeneinander; reicht die Breite nicht (lange Übersetzungen), bricht die Reihe um -->
            <WrapPanel>
                <WrapPanel.Resources>
                    <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                        <Setter Property="GroupName" Value="Action" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Margin" Value="0,0,12,0" />
                        <EventSetter Event="Checked" Handler="OnActionChanged" />
                    </Style>
                </WrapPanel.Resources>
                <RadioButton x:Name="ActionFocus" Content="{x:Static ui:Strings.PickerActionFocus}" ToolTip="{x:Static ui:Strings.PickerActionFocusToolTip}" />
                <RadioButton x:Name="ActionClick" Content="{x:Static ui:Strings.PickerActionClick}" ToolTip="{x:Static ui:Strings.PickerActionClickToolTip}" />
                <RadioButton x:Name="ActionDoubleClick" Content="{x:Static ui:Strings.PickerActionDoubleClick}" ToolTip="{x:Static ui:Strings.PickerActionDoubleClickToolTip}" />
                <RadioButton x:Name="ActionRightClick" Content="{x:Static ui:Strings.PickerActionRightClick}" ToolTip="{x:Static ui:Strings.PickerActionRightClickToolTip}" />
                <RadioButton x:Name="ActionSet" Content="{x:Static ui:Strings.PickerActionSet}" ToolTip="{x:Static ui:Strings.PickerActionSetToolTip}" />
            </WrapPanel>
            <CheckBox x:Name="IncludeWindowInput" Content="{x:Static ui:Strings.PickerIncludeWindow}" Margin="0,6,0,0"
                      ToolTip="{x:Static ui:Strings.PickerIncludeWindowToolTip}" Click="OnIncludeWindowChanged" />
            <TextBlock Text="{x:Static ui:Strings.PickerSelectors}" Margin="0,10,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ListBox x:Name="SelectorList" MaxHeight="130" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                     SelectionChanged="OnSelectorChanged" />
            <!-- Der Tag über die ganze Breite und umbrochen, damit man sieht, was eingefügt wird -->
            <TextBox x:Name="TagOutput" Margin="0,10,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                     TextWrapping="Wrap" VerticalContentAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <!-- Den Tag wirklich ausführen, im Programm, in dem das Element erfasst wurde -->
                <Button x:Name="TestButton" Content="{x:Static ui:Strings.PickerTest}" MinWidth="90"
                        ToolTip="{x:Static ui:Strings.PickerTestToolTip}" Click="OnTest" />
                <Button x:Name="CopyButton" Content="{x:Static ui:Strings.PickerCopy}" MinWidth="90" Margin="8,0,0,0"
                        Style="{DynamicResource AccentButtonStyle}" Click="OnCopy" />
                <!-- Nur wenn ein Editor offen ist: Tag dort an der Schreibmarke einfügen. Dann ist er der blaue, nicht Kopieren -->
                <Button x:Name="InsertButton" Content="{x:Static ui:Strings.PickerInsert}" Margin="8,0,0,0"
                        Style="{DynamicResource AccentButtonStyle}" Visibility="Collapsed" Click="OnInsert" />
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</Window>
