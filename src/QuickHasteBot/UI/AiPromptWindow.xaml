<Window x:Class="QuickHasteBot.UI.AiPromptWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:QuickHasteBot.UI"
        Title="{x:Static ui:Strings.AiPromptTitle}"
        Icon="pack://application:,,,/QuickHasteBot;component/Assets/QuickHasteBot.ico"
        Width="560" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <Style x:Key="Link" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,16,20,20">
        <TextBlock Text="{x:Static ui:Strings.AiPromptLabel}" Margin="0,0,0,8" />
        <Grid>
            <TextBox x:Name="RequirementInput" AcceptsReturn="True" TextWrapping="Wrap" MinLines="3" MaxLines="8"
                     VerticalScrollBarVisibility="Auto" TextChanged="OnRequirementChanged" />
            <TextBlock x:Name="Placeholder" Text="{x:Static ui:Strings.AiPromptPlaceholder}" Margin="12,6,12,0"
                       TextWrapping="Wrap" IsHitTestVisible="False"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </Grid>

        <Expander Header="{x:Static ui:Strings.AiPromptPreview}" Margin="0,12,0,0">
            <TextBox x:Name="PromptPreview" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200" Margin="0,6,0,0"
                     VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
        </Expander>

        <!-- Rechts: eigene Vorlage ai-prompt.txt, wird beim ersten Mal mit dem eingebauten Prompt angelegt.
             Zurücksetzen nur, wenn es eine gibt. -->
        <DockPanel Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0">
                <TextBlock Text="{x:Static ui:Strings.AiPromptEditTemplate}" Style="{StaticResource Link}" HorizontalAlignment="Right"
                           MouseLeftButtonUp="OnEditTemplate" />
                <TextBlock x:Name="ResetTemplateLink" Text="{x:Static ui:Strings.AiPromptResetTemplate}" Style="{StaticResource Link}"
                           HorizontalAlignment="Right" Margin="0,4,0,0" MouseLeftButtonUp="OnResetTemplate" />
            </StackPanel>
            <TextBlock Text="{x:Static ui:Strings.AiPromptHint}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </DockPanel>

        <!-- Links der Dienst, dieselbe Einstellung wie im Einstellungsfenster. Rechts die Knöpfe. -->
        <DockPanel Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="OpenButton" MinWidth="100" Style="{DynamicResource AccentButtonStyle}" Click="OnOpen" />
                <Button Content="{x:Static ui:Strings.Close}" MinWidth="100" Margin="8,0,0,0" Click="OnClose" />
            </StackPanel>
            <ComboBox x:Name="ServiceInput" MinWidth="160" HorizontalAlignment="Left" VerticalAlignment="Center"
                      ToolTip="{x:Static ui:Strings.AiServiceToolTip}" SelectionChanged="OnServiceChanged" />
        </DockPanel>

        <!-- Antwort der KI einfügen und gleich ausführen, bevor sie in einem Baustein landet -->
        <Separator Margin="0,16,0,12" />
        <TextBlock Text="{x:Static ui:Strings.AiPromptTestHeading}" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Grid>
            <TextBox x:Name="AnswerInput" AcceptsReturn="True" TextWrapping="Wrap" MinLines="2" MaxLines="6"
                     VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                     TextChanged="OnAnswerChanged" />
            <TextBlock x:Name="AnswerPlaceholder" Text="{x:Static ui:Strings.AiPromptTestPlaceholder}" Margin="12,6,12,0"
                       TextWrapping="Wrap" IsHitTestVisible="False"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </Grid>
        <Border x:Name="TestResultBox" Margin="0,8,0,0" Padding="10,6" CornerRadius="4" BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Visibility="Collapsed">
            <TextBlock x:Name="TestResult" TextWrapping="Wrap" FontSize="12" />
        </Border>
        <!-- Fertigen Block in die Zwischenablage, mit {{ }} auch wenn die KI sie weggelassen hat -->
        <DockPanel x:Name="CopyRow" Margin="0,8,0,0" Visibility="Collapsed">
            <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="{x:Static ui:Strings.AiPromptCopyBlock}" MinWidth="100"
                    Click="OnCopyBlock" />
            <Button x:Name="InsertButton" DockPanel.Dock="Right" Content="{x:Static ui:Strings.PickerInsert}" MinWidth="100"
                    Margin="0,0,8,0" Visibility="Collapsed" Click="OnInsertBlock" />
            <TextBlock x:Name="WrappedHint" Text="{x:Static ui:Strings.AiPromptWrapped}" FontSize="12" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </DockPanel>
    </StackPanel>
</Window>
