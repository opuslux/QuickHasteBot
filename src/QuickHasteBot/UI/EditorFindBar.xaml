<UserControl x:Class="QuickHasteBot.UI.EditorFindBar"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:QuickHasteBot.UI"
             Visibility="Collapsed">

    <UserControl.Resources>
        <!-- Kleine Symbolknöpfe wie der Umbruch-Schalter im Editor, ohne Fokus: Tab springt nur zwischen den Feldern -->
        <Style x:Key="FindIcon" TargetType="ButtonBase">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Aa eingeschaltet: Akzentfarbe auf getönter Fläche -->
        <Style x:Key="FindToggle" TargetType="ToggleButton" BasedOn="{StaticResource FindIcon}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Streifen oben im Textrahmen, der Text rückt darunter und wird nie verdeckt: Suchen, darunter auf Wunsch
         Ersetzen. Die Felder stehen links untereinander, Schliessen ganz rechts. -->
    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="4,4,0,0"
            Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="6,5">
        <DockPanel>
            <!-- Ersetzen ein-/ausblenden, wie in VS Code links neben den Feldern -->
            <ToggleButton x:Name="ReplaceToggle" DockPanel.Dock="Left" Style="{StaticResource FindToggle}" Margin="0,0,4,0"
                          VerticalAlignment="Stretch" Height="Auto" Width="18" Content="&#xE76C;" FontSize="10"
                          ToolTip="{x:Static ui:Strings.FindToggleReplaceToolTip}" Click="OnReplaceToggleClick" />
            <Button DockPanel.Dock="Right" Style="{StaticResource FindIcon}" VerticalAlignment="Top" Margin="8,3,0,0" Content="&#xE711;"
                    ToolTip="{x:Static ui:Strings.FindCloseToolTip}" Click="OnCloseClick" />
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid Width="240">
                        <TextBox x:Name="FindInput" TextChanged="OnFindTextChanged" PreviewKeyDown="OnFindKeyDown" />
                        <TextBlock x:Name="FindPlaceholder" Text="{x:Static ui:Strings.FindPlaceholder}" Margin="11,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Grid>
                    <ToggleButton x:Name="MatchCaseToggle" Style="{StaticResource FindToggle}" Margin="8,0,0,0" Content="Aa" FontFamily="Segoe UI"
                                  ToolTip="{x:Static ui:Strings.FindMatchCaseToolTip}" Click="OnMatchCaseClick" />
                    <Button Style="{StaticResource FindIcon}" Content="&#xE74A;" ToolTip="{x:Static ui:Strings.FindPreviousToolTip}"
                            Click="OnPreviousClick" />
                    <Button Style="{StaticResource FindIcon}" Content="&#xE74B;" ToolTip="{x:Static ui:Strings.FindNextToolTip}"
                            Click="OnNextClick" />
                    <TextBlock x:Name="CountText" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel x:Name="ReplaceRow" Orientation="Horizontal" Margin="0,5,0,0" Visibility="Collapsed">
                    <Grid Width="240">
                        <TextBox x:Name="ReplaceInput" TextChanged="OnReplaceTextChanged" PreviewKeyDown="OnReplaceKeyDown" />
                        <TextBlock x:Name="ReplacePlaceholder" Text="{x:Static ui:Strings.ReplacePlaceholder}" Margin="11,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Grid>
                    <Button x:Name="ReplaceButton" Content="{x:Static ui:Strings.FindReplace}" ToolTip="{x:Static ui:Strings.FindReplaceToolTip}"
                            Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center" Click="OnReplaceClick" />
                    <Button x:Name="ReplaceAllButton" Content="{x:Static ui:Strings.FindReplaceAll}" ToolTip="{x:Static ui:Strings.FindReplaceAllToolTip}"
                            Padding="10,4" Margin="6,0,0,0" VerticalAlignment="Center" Click="OnReplaceAllClick" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
